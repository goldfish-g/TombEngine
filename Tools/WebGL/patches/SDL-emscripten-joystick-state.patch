diff --git a/src/joystick/emscripten/SDL_sysjoystick.c b/src/joystick/emscripten/SDL_sysjoystick.c
index adf471a..7c6e901 100644
--- a/src/joystick/emscripten/SDL_sysjoystick.c
+++ b/src/joystick/emscripten/SDL_sysjoystick.c
@@ -164,7 +164,15 @@ static EM_BOOL Emscripten_JoyStickConnected(int eventType, const EmscriptenGamep
         }
     }
 
-    if (SDL_strcmp(gamepadEvent->mapping, "standard") == 0) {
+    // On Android, browsers lay out every gamepad in the standard order: Firefox calls
+    // them all standard, Chrome only those it has a mapping of its own for, but it
+    // orders the others the same way (buttons A, B, X, Y, shoulders, triggers, select,
+    // start, stick clicks, d-pad, then home if there is one; the sticks on the first
+    // four axes, then any extra axes, which are left out here).
+    const bool is_standard = (SDL_strcmp(gamepadEvent->mapping, "standard") == 0);
+    const bool is_android_layout = !is_standard && (os_id == 1) && (gamepadEvent->numButtons >= 16) && (gamepadEvent->numAxes >= 4);
+
+    if (is_standard) {
         // We should differentiate between devices that are mapped or unmapped by the browser.
         os_id += 0x80;
     }
@@ -194,13 +202,13 @@ static EM_BOOL Emscripten_JoyStickConnected(int eventType, const EmscriptenGamep
     }
 
     const int real_button_count = gamepadEvent->numButtons;
-    const int real_axis_count = gamepadEvent->numAxes;
+    const int real_axis_count = is_android_layout ? 4 : gamepadEvent->numAxes;
     int first_trigger_button = -1;
     int first_hat_button = -1;
     int num_buttons = gamepadEvent->numButtons;
-    int num_axes = gamepadEvent->numAxes;
+    int num_axes = real_axis_count;
     bool triggers_are_buttons = false;
-    if ((SDL_strcmp(gamepadEvent->mapping, "standard") == 0) && (num_buttons >= 16)) {  // maps to a game console gamepad layout, turn the d-pad into a hat, treat triggers as analog.
+    if ((is_standard || is_android_layout) && (num_buttons >= 16)) {  // maps to a game console gamepad layout, turn the d-pad into a hat, treat triggers as analog.
         num_buttons -= 4;  // 4 dpad buttons become a hat.
         first_hat_button = 12;
 
@@ -214,6 +222,14 @@ static EM_BOOL Emscripten_JoyStickConnected(int eventType, const EmscriptenGamep
         num_buttons -= 2;
     }
 
+    // The default mapping reads the triggers from axes 4 and 5. Devices with fewer
+    // axes get resting ones up to there, so their triggers read as released (an axis
+    // that does not exist reads 0, which is a half-pressed trigger).
+    if (num_axes < 6) {
+        num_axes = 6;
+    }
+
+    item->browser_axes = real_axis_count;
     item->first_hat_button = first_hat_button;
     item->first_trigger_button = first_trigger_button;
     item->triggers_are_buttons = triggers_are_buttons;
@@ -504,6 +520,10 @@ static bool EMSCRIPTEN_JoystickOpen(SDL_Joystick *joystick, int device_index)
     joystick->nbuttons = item->nbuttons;
     joystick->naxes = item->naxes;
 
+    // An opened joystick's axes read 0 (a half-pressed trigger) until a value is sent,
+    // so the first update sends the whole state rather than only what changed.
+    item->sync_state = true;
+
     item->rumble_available = MAIN_THREAD_EM_ASM_INT({
         let gamepad = navigator['getGamepads']()[$0];
         return gamepad && gamepad['vibrationActuator'] && gamepad['vibrationActuator']['effects']['includes']('dual-rumble');
@@ -542,11 +562,12 @@ static void EMSCRIPTEN_JoystickUpdate(SDL_Joystick *joystick)
     if (item) {
         result = emscripten_get_gamepad_status(item->index, &gamepadState);
         if (result == EMSCRIPTEN_RESULT_SUCCESS) {
-            if (gamepadState.timestamp == 0 || gamepadState.timestamp != item->timestamp) {
+            if (item->sync_state || gamepadState.timestamp == 0 || gamepadState.timestamp != item->timestamp) {
+                const bool sync = item->sync_state;
                 const int first_hat_button = item->first_hat_button;
                 const int first_trigger_button = item->first_trigger_button;
                 const int real_button_count = gamepadState.numButtons;
-                const int real_axis_count = gamepadState.numAxes;
+                const int real_axis_count = SDL_min(gamepadState.numAxes, item->browser_axes);
 
                 int buttonidx = 0;
                 for (i = 0; i < real_button_count; i++, buttonidx++) {
@@ -555,7 +576,7 @@ static void EMSCRIPTEN_JoystickUpdate(SDL_Joystick *joystick)
                     } else if (buttonidx == first_trigger_button) {
                         buttonidx += 2;  // skip these buttons, we're treating them as axes.
                     }
-                    if (item->digitalButton[i] != gamepadState.digitalButton[buttonidx]) {
+                    if (sync || item->digitalButton[i] != gamepadState.digitalButton[buttonidx]) {
                         const bool down = (gamepadState.digitalButton[buttonidx] != 0);
                         SDL_SendJoystickButton(timestamp, item->joystick, i, down);
                     }
@@ -566,7 +587,7 @@ static void EMSCRIPTEN_JoystickUpdate(SDL_Joystick *joystick)
                 }
 
                 for (i = 0; i < real_axis_count; i++) {
-                    if (item->axis[i] != gamepadState.axis[i]) {
+                    if (sync || item->axis[i] != gamepadState.axis[i]) {
                         SDL_SendJoystickAxis(timestamp, item->joystick, i, (Sint16)(32767.0f * gamepadState.axis[i]));
                         item->axis[i] = gamepadState.axis[i];
                     }
@@ -574,13 +595,21 @@ static void EMSCRIPTEN_JoystickUpdate(SDL_Joystick *joystick)
 
                 if (item->triggers_are_buttons) {
                     for (i = 0; i < 2; i++) {
-                        if (item->axis[real_axis_count+i] != gamepadState.analogButton[first_trigger_button+i]) {
+                        if (sync || item->axis[real_axis_count+i] != gamepadState.analogButton[first_trigger_button+i]) {
                             SDL_SendJoystickAxis(timestamp, item->joystick, real_axis_count+i, (Sint16)(32767.0f * ((gamepadState.analogButton[first_trigger_button+i] * 2.0f) - 1.0f)));
                             item->axis[real_axis_count+i] = gamepadState.analogButton[first_trigger_button+i];
                         }
                     }
                 }
 
+                // Trigger axes added for devices without them rest at the minimum (see
+                // Emscripten_JoyStickConnected); added stick axes rest at 0, as unsent axes do.
+                if (sync) {
+                    for (i = SDL_max(real_axis_count + (item->triggers_are_buttons ? 2 : 0), 4); i < item->naxes; i++) {
+                        SDL_SendJoystickAxis(timestamp, item->joystick, i, SDL_JOYSTICK_AXIS_MIN);
+                    }
+                }
+
                 SDL_assert(item->nhats <= 1);  // there is (currently) only ever one of these, faked from the d-pad buttons.
                 if (item->nhats) {
                     Uint8 value = SDL_HAT_CENTERED;
@@ -595,13 +624,14 @@ static void EMSCRIPTEN_JoystickUpdate(SDL_Joystick *joystick)
                     } else if (gamepadState.digitalButton[first_hat_button + 3]) {
                         value |= SDL_HAT_RIGHT;
                     }
-                    if (item->hat != value) {
+                    if (sync || item->hat != value) {
                         item->hat = value;
                         SDL_SendJoystickHat(timestamp, item->joystick, 0, value);
                     }
                 }
 
 
+                item->sync_state = false;
                 item->timestamp = gamepadState.timestamp;
             }
         }
diff --git a/src/joystick/emscripten/SDL_sysjoystick_c.h b/src/joystick/emscripten/SDL_sysjoystick_c.h
index c23d544..fe67158 100644
--- a/src/joystick/emscripten/SDL_sysjoystick_c.h
