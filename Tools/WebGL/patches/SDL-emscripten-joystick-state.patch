     int nbuttons;
     int naxes;
     double timestamp;
+    bool sync_state;            // send the whole state at the next update (set when opened)
+    int browser_axes;           // the browser's axes read (Chrome on Android may add extra ones)
     double axis[64];            // !!! FIXME: don't hardcode 64 on all of these.
     double analogButton[64];
     EM_BOOL digitalButton[64];
